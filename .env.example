REMOTION_MAPBOX_TOKEN=

# コンポジション別プレビュー背景（composition-canvas-preview.ts）をレンダーに焼き込むか。
# 0=オフ / 1=オン。Studio では常にマップに従う。
# render.sh はこの値に依らず既定で 0 にし、--with-canvas-bg のときだけ 1 にする。
# npx remotion render 直叩きのときだけ、この変数が webpack に渡る（未設定なら remotion.config で "0"）。
# REMOTION_CANVAS_BACKGROUND=0

# テンプレの全画面下敷きを透明にする（1=オン）。render.sh は --transparent-bg で 1 にする。
# REMOTION_TRANSPARENT_COMPOSITION_BACKDROP=0

# ---- render.sh の書き出し設定（render.sh が .env を読み込む。コマンドの前に書いた値が優先） ----

# 書き出し先フォルダー。絶対パス、~/ から始まるパス、リポジトリからの相対パス。未設定ならリポジトリの out/。
# REMOTION_OUTPUT_DIR=~/Movies/remotion-video-ui-library

# Google Drive への自動アップロード。0 で無効（出力フォルダーに残す）。
# REMOTION_UPLOAD=0

# アップロード先（rclone のリモート名:Drive内のフォルダーパス）。未設定ならアップロードしない。
# REMOTION_UPLOAD_REMOTE=gdrive:path/to/folder
