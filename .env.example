REMOTION_MAPBOX_TOKEN=

# Whether to bake the per-composition preview background (composition-canvas-preview.ts) into renders.
# 0=off / 1=on. Studio always follows the map.
# render.sh ignores this value, defaults to 0, and sets 1 only with --with-canvas-bg.
# This variable reaches webpack only when calling `npx remotion render` directly (remotion.config uses "0" when unset).
# REMOTION_CANVAS_BACKGROUND=0

# Make the templates' full-screen backdrop transparent (1=on). render.sh sets 1 with --transparent-bg.
# REMOTION_TRANSPARENT_COMPOSITION_BACKDROP=0

# ---- render.sh export settings (render.sh loads .env; values written before the command take precedence) ----

# Output folder. Absolute path, path starting with ~/, or path relative to the repository. Defaults to the repository's out/ when unset.
# REMOTION_OUTPUT_DIR=~/Movies/remotion-video-ui-library

# Automatic upload to Google Drive. 0 disables it (outputs stay in the output folder).
# REMOTION_UPLOAD=0

# Upload destination (rclone remote name:folder path in Drive). No upload when unset.
# REMOTION_UPLOAD_REMOTE=gdrive:path/to/folder
