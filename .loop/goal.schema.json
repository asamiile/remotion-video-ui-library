{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/remotion-loop-goal.schema.json",
  "title": "Remotion repository autonomous goal",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "objective", "acceptance", "verification", "limits", "humanGates"],
  "properties": {
    "$schema": {"type": "string"},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"},
    "objective": {"type": "string", "minLength": 10},
    "acceptance": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 3}},
    "allowedPaths": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "forbiddenActions": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "verification": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "command"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "command": {"type": "string", "minLength": 1},
          "timeoutSeconds": {"type": "integer", "minimum": 1, "maximum": 1800}
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxAttempts", "maxMinutes", "maxConsecutiveNoProgress"],
      "properties": {
        "maxAttempts": {"type": "integer", "minimum": 1, "maximum": 50},
        "maxMinutes": {"type": "integer", "minimum": 1, "maximum": 1440},
        "maxConsecutiveNoProgress": {"type": "integer", "minimum": 1, "maximum": 10}
      }
    },
    "humanGates": {"type": "array", "items": {"enum": ["full-render", "delete", "commit", "push", "merge", "publish", "external-write"]}}
  }
}
